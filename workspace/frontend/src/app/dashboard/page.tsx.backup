} from '@/components/ui/dropdown-menu';
import { 
  Coffee,
  LayoutDashboard,
  ShoppingCart,
  UtensilsCrossed,
  Users,
  Award,
  Star,
  BarChart3,
  Megaphone,
  QrCode,
  Settings,
  CreditCard,
  UserCircle,
  LogOut,
  ChevronDown,
  Bell,
  Menu,
  X,
  TrendingUp,
  TrendingDown,
  DollarSign,
  Clock,
  ChevronRight
} from 'lucide-react';
import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer, AreaChart, Area, BarChart, Bar } from 'recharts';

const sidebarItems = [
  { href: '/dashboard', label: 'Dashboard', icon: LayoutDashboard },
  { href: '/dashboard/orders', label: 'Orders', icon: ShoppingCart, badge: '12' },
  { href: '/dashboard/menu', label: 'Menu', icon: UtensilsCrossed },
  { href: '/dashboard/customers', label: 'Customers', icon: Users },
  { href: '/dashboard/loyalty', label: 'Loyalty', icon: Award },
  { href: '/dashboard/reviews', label: 'Reviews', icon: Star },
  { href: '/dashboard/analytics', label: 'Analytics', icon: BarChart3 },
  { href: '/dashboard/marketing', label: 'Marketing', icon: Megaphone },
  { href: '/dashboard/qr-codes', label: 'QR Codes', icon: QrCode },
  { href: '/dashboard/settings', label: 'Settings', icon: Settings },
];

const bottomItems = [
  { href: '/dashboard/billing', label: 'Billing', icon: CreditCard },
  { href: '/dashboard/team', label: 'Team', icon: UserCircle },
];

const revenueData = [
  { name: 'Mon', revenue: 2400, orders: 24 },
  { name: 'Tue', revenue: 1398, orders: 18 },
  { name: 'Wed', revenue: 9800, orders: 42 },
  { name: 'Thu', revenue: 3908, orders: 32 },
  { name: 'Fri', revenue: 4800, orders: 38 },
  { name: 'Sat', revenue: 3800, orders: 35 },
  { name: 'Sun', revenue: 4300, orders: 40 },
];

const recentOrders = [
  { id: 'ORD-001', table: 'A12', customer: 'John Smith', items: 3, amount: 84.00, status: 'completed', time: '2 min ago' },
  { id: 'ORD-002', table: 'B05', customer: 'Sarah Johnson', items: 2, amount: 56.50, status: 'preparing', time: '5 min ago' },
  { id: 'ORD-003', table: 'C08', customer: 'Mike Davis', items: 4, amount: 112.00, status: 'pending', time: '8 min ago' },
  { id: 'ORD-004', table: 'A03', customer: 'Emily Chen', items: 1, amount: 28.00, status: 'completed', time: '12 min ago' },
  { id: 'ORD-005', table: 'B12', customer: 'David Wilson', items: 2, amount: 67.50, status: 'ready', time: '15 min ago' },
];

const topProducts = [
  { name: 'Caramel Macchiato', sales: 142, revenue: 1988, trend: 'up' },
  { name: 'Avocado Toast', sales: 98, revenue: 1372, trend: 'up' },
  { name: 'Cold Brew', sales: 87, revenue: 1087, trend: 'down' },
  { name: 'Eggs Benedict', sales: 76, revenue: 1368, trend: 'up' },
  { name: 'Matcha Latte', sales: 65, revenue: 910, trend: 'up' },
];

export default function DashboardPage() {
  const pathname = usePathname();
  const [isSidebarOpen, setIsSidebarOpen] = useState(false);

